# Python Virtual Environment
.venv/
env/
venv/
ENV/

# Python Cache
__pycache__/
*.py[cod]
*$py.class

# Environment Variables
.env
*.env

# Data and Outputs (Ignore generated files, keep directory structure via .gitkeep)
workspaces/*
!workspaces/.gitkeep

data/*
!data/.gitkeep

sandbox/*
!sandbox/.gitkeep
!sandbox/plots/
sandbox/plots/*
!sandbox/plots/.gitkeep

reports/*
!reports/.gitkeep

# IDE and System Files
.vscode/
.idea/
.DS_Store
*.swp
*.swo

# LangGraph / SQLite local state
*.sqlite
*.db
